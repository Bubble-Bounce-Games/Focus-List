{
  "name": "focus-list",
  "version": "0.21.2",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build --webpack && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "build:sites": "SITES_STATIC_EXPORT=1 next build --webpack",
    "build:aws": "SITES_STATIC_EXPORT=1 next build --webpack",
    "build:github": "GITHUB_PAGES=1 GITHUB_PAGES_CUSTOM_DOMAIN=1 next build --webpack",
    "start": "NODE_ENV=production node .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "icons": "node scripts/generate-icons.mjs",
    "domain": "./scripts/local-domain.sh status",
    "check:imports": "./scripts/check-imports.sh",
    "typecheck": "tsc --noEmit",
    "test": "./scripts/test-logic.sh",
    "verify": "yarn check:imports && yarn typecheck && yarn lint && yarn test && yarn build"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.2",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.1.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "sharp": "^0.34.3",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
